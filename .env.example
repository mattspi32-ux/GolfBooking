# BRS Golf Login Credentials
BRS_USERNAME=your_membership_number
BRS_PASSWORD=your_password

# Club Configuration
CLUB_NAME=newcastleunited

# Player BRS IDs (your ID is player 1, others are optional playing partners)
PLAYER_1=your_brs_player_id
PLAYER_2=
PLAYER_3=
PLAYER_4=

# Booking Preferences
# Comma-separated preferred tee times in HH:MM format (earliest to latest preference)
TEE_TIME_PREFERENCES=08:00,08:10,08:20,08:30

# How many days ahead bookings open (check with your club)
BOOKING_WINDOW_DAYS=7

# Time bookings are released (24hr format HH:MM:SS)
BOOKING_RELEASE_TIME=07:30:00

# Number of holes (18 or 9)
HOLES=18
